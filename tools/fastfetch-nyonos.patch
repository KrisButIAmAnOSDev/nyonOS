diff --git a/CMakeToolchain-nyonos.txt b/CMakeToolchain-nyonos.txt
new file mode 100644
index 0000000..3cb5381
--- /dev/null
+++ b/CMakeToolchain-nyonos.txt
@@ -0,0 +1,42 @@
+set(CMAKE_SYSTEM_NAME nyonos)
+set(CMAKE_SYSTEM_PROCESSOR x86_64)
+
+set(NYONOS_TOOLCHAIN "$ENV{NYONOS_TOOLCHAIN}" CACHE PATH "nyonOS toolchain prefix")
+set(NYONOS_SYSROOT "$ENV{NYONOS_SYSROOT}" CACHE PATH "nyonOS sysroot")
+set(NYONOS_LDSCRIPT "$ENV{NYONOS_LDSCRIPT}" CACHE PATH "mlibc linker script")
+
+if(NOT NYONOS_TOOLCHAIN)
+    set(NYONOS_TOOLCHAIN "${CMAKE_CURRENT_LIST_DIR}/../../../../nyonos-toolchain/toolchain16")
+endif()
+if(NOT NYONOS_SYSROOT)
+    set(NYONOS_SYSROOT "${CMAKE_CURRENT_LIST_DIR}/../../../../nyonos-toolchain/sysroot")
+endif()
+if(NOT NYONOS_LDSCRIPT)
+    set(NYONOS_LDSCRIPT "${CMAKE_CURRENT_LIST_DIR}/../../../../mlibc/sysdeps/nyonos/nyonos.ld")
+endif()
+
+set(CMAKE_C_COMPILER "${NYONOS_TOOLCHAIN}/bin/x86_64-nyonos-gcc")
+set(CMAKE_CXX_COMPILER "${NYONOS_TOOLCHAIN}/bin/x86_64-nyonos-g++")
+set(CMAKE_AR "${NYONOS_TOOLCHAIN}/bin/x86_64-nyonos-ar")
+set(CMAKE_RANLIB "${NYONOS_TOOLCHAIN}/bin/x86_64-nyonos-ranlib")
+set(CMAKE_STRIP "${NYONOS_TOOLCHAIN}/bin/x86_64-nyonos-strip")
+set(CMAKE_OBJDUMP "${NYONOS_TOOLCHAIN}/bin/x86_64-nyonos-objdump")
+
+set(CMAKE_SYSROOT ${NYONOS_SYSROOT})
+set(CMAKE_FIND_ROOT_PATH ${NYONOS_SYSROOT})
+
+set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
+set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
+set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
+set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
+
+# the nyonOS C++ library is not installed yet at configure time, so the
+# compiler probe must not link an executable
+set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
+
+# mlibc provides pthread symbols in libc itself; do not look for -lpthreads
+set(CMAKE_HAVE_LIBC_PTHREAD TRUE CACHE INTERNAL "pthreads are in libc")
+
+set(CMAKE_EXE_LINKER_FLAGS_INIT "-L${NYONOS_SYSROOT}/usr/local/lib -Wl,-dynamic-linker,/usr/lib/ld.so -Wl,-rpath,/usr/lib")
+set(CMAKE_C_FLAGS_INIT "-fPIC")
+set(CMAKE_CXX_FLAGS_INIT "-fPIC")
