/* The entire syscall ABI in one place: name, number, return type, argument
   count, and the typed parameter list. Every consumer is generated from this,
   so the numbers, arity and argument types cannot drift apart.

   Each row also carries the bare argument names, so the same row can
   generate a declaration and the call that fills it in.  */

#ifndef SYSCALLS_DEF
#define SYSCALLS                                                                     \
    X(read         ,    1, int64_t, 3, N(fd,(ulong)buf,len), int fd, void *buf, unsigned len) \
    X(write        ,    2, int64_t, 3, N(fd,(ulong)buf,len), int fd, const void *buf, unsigned len) \
    X(pread        ,    3, int64_t, 4, N(fd,(ulong)buf,len,off), int fd, void *buf, unsigned len, int64_t off) \
    X(open         ,    4, int32_t, 2, N((ulong)path,flags), const char *path, int flags) \
    X(close        ,    5, int32_t, 1, N(fd), int fd) \
    X(lseek        ,    6, int64_t, 3, N(fd,off,whence), int fd, int64_t off, int whence) \
    X(dup          ,    7, int32_t, 3, N(fd,cloexec,rights), int fd, int cloexec, unsigned rights) \
    X(fstat        ,    8, int32_t, 2, N(fd,(ulong)st), int fd, struct sys_stat *st) \
    X(getdents     ,    9, int32_t, 3, N(fd,index,(ulong)buf), int fd, unsigned index, struct sys_dirent *buf) \
    X(isatty       ,   10, int32_t, 1, N(fd), int fd) \
    X(stat         ,   11, int32_t, 2, N((ulong)path,(ulong)st), const char *path, struct sys_stat *st) \
    X(dup2         ,   12, int32_t, 3, N(oldfd,newfd,flags), int oldfd, int newfd, unsigned flags) \
    X(fcntl        ,   13, int32_t, 3, N(fd,cmd,arg), int fd, unsigned cmd, int64_t arg) \
    X(ioctl        ,   14, int64_t, 3, N(fd,req,arg), int fd, unsigned req, int64_t arg) \
    X(exit         ,   16, int32_t, 1, N(code), int code) \
    X(getpid       ,   17, int32_t, 0, N(0)) \
    X(sleep        ,   18, int32_t, 1, N(ms), unsigned ms) \
    X(mmap         ,   19, int64_t, 3, N(len,prot,flags), uint64_t len, unsigned prot, unsigned flags) \
    X(munmap       ,   20, int32_t, 2, N(addr,len), uint64_t addr, uint64_t len) \
    X(clock_gettime,   21, int32_t, 2, N(clk,(ulong)ts), unsigned clk, struct sys_timespec *ts) \
    X(futex        ,   22, int32_t, 4, N((ulong)addr,op,val,(ulong)ts), uint32_t *addr, unsigned op, uint32_t val, struct sys_timespec *ts) \
    X(yield        ,   24, int32_t, 0, N(0)) \
    X(newthread    ,   25, int32_t, 3, N((ulong)pid_out,entry,stack), uint32_t *pid_out, uint64_t entry, uint64_t stack) \
    X(thread_exit  ,   26, int32_t, 0, N(0)) \
    X(fork        ,   27, int32_t, 1, N((ulong)tid_out), uint32_t *tid_out) \
    X(vfork       ,   28, int32_t, 1, N((ulong)tid_out), uint32_t *tid_out) \
    X(clone       ,   29, int32_t, 4, N(flags,stack,(ulong)tid_out,tcb), uint64_t flags, uint64_t stack, uintptr_t tid_out, uint64_t tcb) \
    X(waitpid     ,   30, int32_t, 3, N(pid,(ulong)status,(ulong)options), int32_t pid, uintptr_t status, int32_t options) \
    X(execve      ,   31, int32_t, 3, N((ulong)path,(ulong)argv,(ulong)envp), uintptr_t path, uintptr_t argv, uintptr_t envp) \
    X(cow_ctl      ,   32, int32_t, 1, N(on), int32_t on) \
    X(getppid      ,   33, int32_t, 0, N(0)) \
    X(getuid       ,   34, int32_t, 0, N(0)) \
    X(geteuid      ,   35, int32_t, 0, N(0)) \
    X(getgid       ,   36, int32_t, 0, N(0)) \
    X(getegid      ,   37, int32_t, 0, N(0)) \
    X(getresuid    ,   38, int32_t, 3, N((ulong)r,(ulong)e,(ulong)s), uint32_t *r, uint32_t *e, uint32_t *s) \
    X(getresgid    ,   39, int32_t, 3, N((ulong)r,(ulong)e,(ulong)s), uint32_t *r, uint32_t *e, uint32_t *s) \
    X(sethostname  ,   40, int32_t, 2, N((ulong)name,len), const char *name, size_t len) \
    X(gethostname  ,   41, int32_t, 2, N((ulong)name,len), char *name, size_t len) \
    X(poll         ,   42, int32_t, 4, N((ulong)fds,nfds,timeout,(ulong)events), struct sys_pollfd *fds, uint32_t nfds, int32_t timeout, int32_t *events) \
    X(tcgetattr    ,   43, int32_t, 2, N(fd,(ulong)attr), int fd, struct sys_termios *attr) \
    X(tcsetattr    ,   44, int32_t, 3, N(fd,act,(ulong)attr), int fd, int act, const struct sys_termios *attr) \
    X(tcgetwinsize ,   45, int32_t, 2, N(fd,(ulong)ws), int fd, struct sys_winsize *ws) \
    X(tcsetwinsize ,   46, int32_t, 2, N(fd,(ulong)ws), int fd, const struct sys_winsize *ws) \
    X(ttyname      ,   47, int32_t, 3, N(fd,(ulong)buf,size), int fd, char *buf, size_t size) \
    X(set_fs_base  ,   23, int32_t, 1, N(base), uint64_t base) \
    X(mprotect      ,   48, int32_t, 3, N(addr,len,prot), uint64_t addr, uint64_t len, unsigned prot) \
    X(pipe          ,   49, int32_t, 1, N((ulong)fds), int *fds) \
    X(mkdir         ,   50, int32_t, 2, N((ulong)path,mode), const char *path, unsigned mode) \
    X(mkdirat       ,   51, int32_t, 3, N(dirfd,(ulong)path,mode), int dirfd, const char *path, unsigned mode) \
    X(unlinkat      ,   52, int32_t, 3, N(dirfd,(ulong)path,flags), int dirfd, const char *path, int flags) \
    X(rmdir         ,   53, int32_t, 1, N((ulong)path), const char *path) \
    X(truncate      ,   54, int32_t, 2, N((ulong)path,length), const char *path, int64_t length) \
    X(ftruncate     ,   55, int32_t, 2, N(fd,length), int fd, int64_t length) \
    X(fsync         ,   56, int32_t, 1, N(fd), int fd) \
    X(fdatasync     ,   57, int32_t, 1, N(fd), int fd) \
    X(sync          ,   58, int32_t, 0, N(0)) \
    X(utimensat     ,   59, int32_t, 4, N(dirfd,(ulong)path,(ulong)times,flags), int dirfd, const char *path, struct sys_timespec2 *times, int flags) \
    X(getcwd        ,   60, int32_t, 2, N((ulong)buf,size), char *buf, size_t size) \
    X(chdir         ,   61, int32_t, 1, N((ulong)path), const char *path) \
    X(kill          ,   62, int32_t, 2, N(pid,sig), int32_t pid, int sig) \
    X(sigaction     ,   63, int32_t, 3, N(sig,(ulong)act,(ulong)old), int sig, const struct sys_sigaction *act, struct sys_sigaction *old) \
    X(sigprocmask   ,   64, int32_t, 3, N(how,(ulong)set,(ulong)old), int how, const uint64_t *set, uint64_t *old) \
    X(fb_map        ,   66, int32_t, 1, N((ulong)out), struct sys_fb *out) \
    X(fstatat      ,   68, int32_t, 4, N(dirfd,(ulong)path,(ulong)st,flags), int dirfd, const char *path, struct sys_stat *st, int flags) \
    X(readlink      ,   69, int32_t, 3, N((ulong)path,(ulong)buf,size), const char *path, char *buf, size_t size) \
    X(symlink      ,   70, int32_t, 2, N((ulong)target,(ulong)path), const char *target, const char *path) \
    X(link          ,   71, int32_t, 2, N((ulong)oldp,(ulong)newp), const char *oldp, const char *newp) \
    X(chmod         ,   72, int32_t, 2, N((ulong)path,mode), const char *path, unsigned mode) \
    X(fchmod       ,   73, int32_t, 2, N(fd,mode), int fd, unsigned mode) \
    X(utimes       ,   74, int32_t, 2, N((ulong)path,(ulong)times), const char *path, struct sys_timespec2 *times) \
    X(setsid       ,   75, int32_t, 0, N(0)) \
    X(getpgid      ,   76, int32_t, 1, N(pid), int32_t pid) \
    X(setpgid      ,   77, int32_t, 2, N(pid,pgid), int32_t pid, int32_t pgid) \
    X(console_write,  240, int64_t, 4, N(dest,attr,(ulong)buf,len), unsigned dest, unsigned attr, const void *buf, unsigned len) \
    X(debug_print  ,  241, int64_t, 2, N((ulong)msg,len), const char *msg, unsigned len)

#endif
